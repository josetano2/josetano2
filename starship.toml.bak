palette = "mint"

format = """
[](#6EE7B7)\
$os\
$username\
[](bg:#34D399 fg:#6EE7B7)\
$directory\
[](fg:#34D399 bg:#10B981)\
$git_branch\
$git_status\
[](fg:#10B981 bg:#059669)\
$c\
$elixir\
$elm\
$golang\
$gradle\
$haskell\
$java\
$julia\
$nodejs\
$nim\
$rust\
$scala\
[](fg:#059669 bg:#047857)\
$docker_context\
[](fg:#047857 bg:#065F46)\
$time\
[](fg:#065F46)\
$line_break$character"""


# You can also replace your username with a neat symbol like   or disable this
# and use the os module below
[username]
show_always = true
style_user = "bg:#6EE7B7 fg:#04231A"
style_root = "bg:#6EE7B7 fg:#04231A"
format = '[ミカ]($style)'
disabled = false

[character]
disabled = false
success_symbol = '[](bold fg:color_green)'
error_symbol = '[](bold fg:color_red)'
vimcmd_symbol = '[](bold fg:color_green)'
vimcmd_replace_one_symbol = '[](bold fg:color_purple)'
vimcmd_replace_symbol = '[](bold fg:color_purple)'
vimcmd_visual_symbol = '[](bold fg:color_yellow)'

# An alternative to the username module which displays a symbol that
# represents the current operating system
[os]
style = "bg:#6EE7B7 fg:#04231A"
disabled = true # Disabled by default

[directory]
style = "bg:#34D399 fg:#04231A"
format = "[ $path ]($style)"
truncation_length = 3
truncation_symbol = "…/"

# Here is how you can shorten some long paths by text replacement
# similar to mapped_locations in Oh My Posh:
[directory.substitutions]
"Documents" = "󰈙 "
"Downloads" = " "
"Music" = " "
"Pictures" = " "
# Keep in mind that the order matters. For example:
# "Important Documents" = " 󰈙 "
# will not be replaced, because "Documents" was already substituted before.
# So either put "Important Documents" before "Documents" or use the substituted version:
# "Important 󰈙 " = " 󰈙 "

[c]
symbol = " "
style = "bg:#059669"
format = '[ $symbol ($version) ]($style)'

[docker_context]
symbol = " "
style = "bg:#047857"
format = '[ $symbol $context ]($style)'

[elixir]
symbol = " "
style = "bg:#059669"
format = '[ $symbol ($version) ]($style)'

[elm]
symbol = " "
style = "bg:#059669"
format = '[ $symbol ($version) ]($style)'

[git_branch]
symbol = ""
style = "bg:#10B981 fg:#04231A"
format = '[ $symbol $branch ]($style)'

[git_status]
style = "bg:#10B981 fg:#04231A"
format = '[$all_status$ahead_behind ]($style)'

[golang]
symbol = " "
style = "bg:#059669"
format = '[ $symbol ($version) ]($style)'

[gradle]
style = "bg:#059669"
format = '[ $symbol ($version) ]($style)'

[haskell]
symbol = " "
style = "bg:#059669"
format = '[ $symbol ($version) ]($style)'

[java]
symbol = " "
style = "bg:#059669"
format = '[ $symbol ($version) ]($style)'

[julia]
symbol = " "
style = "bg:#059669"
format = '[ $symbol ($version) ]($style)'

[nodejs]
symbol = ""
style = "bg:#059669"
format = '[ $symbol ($version) ]($style)'

[nim]
symbol = "󰆥 "
style = "bg:#059669"
format = '[ $symbol ($version) ]($style)'

[rust]
symbol = ""
style = "bg:#059669"
format = '[ $symbol ($version) ]($style)'

[scala]
symbol = " "
style = "bg:#059669"
format = '[ $symbol ($version) ]($style)'

[time]
disabled = false
time_format = "%R" # Hour:Minute Format
style = "bg:#065F46"
format = '[   $time ]($style)'

[palettes.mint]
color_green = "#34D399"
color_red = "#F87171"
color_purple = "#A78BFA"
color_yellow = "#FBBF24"
